{
  "name": "CuadraMe",
  "short_name": "CuadraMe",
  "description": "Cuadra tus cuentas, simple y al día.",
  "start_url": "/",
  "lang": "es-CO",
  "display": "standalone",
  "background_color": "#f7f4ee",
  "theme_color": "#b9461a",
  "icons": [
    {
      "src": "/icons/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-monochrome-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "monochrome"
    }
  ],
  "id": "/",
  "scope": "/",
  "categories": [
    "finance",
    "productivity"
  ],
  "shortcuts": [
    {
      "name": "Registrar un gasto",
      "short_name": "Gasto",
      "description": "Anota un gasto con el teclado listo",
      "url": "/agregar?foco=monto",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Traer movimientos",
      "short_name": "Traer",
      "description": "Revisa lo que llegó del correo o los extractos",
      "url": "/sincronizacion",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Mi presupuesto",
      "short_name": "Presupuesto",
      "url": "/presupuesto",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Registrar un ingreso",
      "short_name": "Ingreso",
      "description": "Anota plata que te entró",
      "url": "/#/agregar?tipo=income&foco=monto",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Pasar plata",
      "short_name": "Pasar plata",
      "description": "Mueve plata entre tus cuentas",
      "url": "/#/agregar?tipo=transfer",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/compartir-archivo",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "archivos",
          "accept": [
            "application/pdf",
            ".pdf",
            "text/csv",
            ".csv",
            "text/plain",
            ".txt",
            "application/vnd.ms-excel",
            ".xls",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            ".xlsx"
          ]
        }
      ]
    }
  }
}
